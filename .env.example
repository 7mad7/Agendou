# PostgreSQL connection string (Supabase / Neon / Local Test DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendou_test?schema=public"

# Segredo para assinatura de sessões (cookies HTTP-only)
AUTH_SECRET="agendou-super-secret-key-change-in-production"

# Em ambiente local HTTP (localhost), manter false; em HTTPS de produção usar true
COOKIE_SECURE="false"
